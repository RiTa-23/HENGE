{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "henge-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22", // vitest-pool-workers 同梱の workerd の上限に合わせる（これより新しいとテストが起動しない）
  "compatibility_flags": ["nodejs_compat"],
  // 外部に公開しない。workers.dev のサブドメインを付けると、Next.js Worker を
  // 経由せず誰でも直接叩けるようになり、「Honoに公開ルートを生やさない」という
  // 前提（＝Next.js側で認証を完結させられる根拠）が崩れる。
  "workers_dev": false,
  // D1 / KV の近くで実行させる。fetchハンドラにしか効かないため、
  // Service Bindings は RPC方式ではなく HTTP方式で呼ぶこと。
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  // 使う生成モデル。切り替えはここを変えてデプロイする（MODELS に無い値は既定にフォールバック）
  "vars": {
    "GENERATION_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
  },
  // D1 / KV / Workers AI へのアクセスは Hono Worker に閉じる。
  // Next.js Worker 側からは直接触らない。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "henge-db",
      "database_id": "6c46368a-5a74-4019-b922-4dff7b2a15da",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "075a3575eb084d58918d6d51e4a9ea85",
    },
  ],
  // 呼び出しは AI Gateway（id: henge）経由にする。docs/05-generation.md を参照。
  // ローカル開発でも Workers AI は常にリモートを叩く（ニューロンを消費する）。
  // remote: true はその事実を明示するもので、挙動は変わらない。
  "ai": {
    "binding": "AI",
    "remote": true,
  },
}
