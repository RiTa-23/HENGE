{
  "name": "henge",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/unidic/fetch-dict.ts --if-missing && concurrently -n backend,frontend,reading -c cyan,magenta,yellow \"bun run --cwd apps/backend dev\" \"bun run --cwd apps/frontend dev\" \"bun run --cwd apps/reading dev\"",
    "preview": "bun run --cwd apps/frontend preview",
    "build": "bun run --cwd apps/frontend build",
    "lint": "oxlint .",
    "format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore .",
    "format:check": "oxfmt --check --ignore-path .gitignore --ignore-path .oxfmtignore .",
    "typecheck": "bun run --cwd apps/backend build:types && bun run --filter '*' typecheck",
    "test": "bun run --cwd packages/shared test && bun run --cwd apps/frontend test && bun run --cwd apps/reading test",
    "test:workers": "bun run --cwd apps/backend test:workers",
    "db:generate": "bun run --cwd apps/backend db:generate",
    "db:migrate:local": "bun run --cwd apps/backend db:migrate:local",
    "rebuild:roman": "bun run --cwd apps/backend scripts/rebuild-roman.ts",
    "compare:constraint": "bun build apps/backend/scripts/compare-constraint-prompts.ts --target=node --external=wrangler --outfile=apps/backend/scripts/.compare-constraint-prompts.mjs && node apps/backend/scripts/.compare-constraint-prompts.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^24",
    "auth": "~1.6.33",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  }
}
