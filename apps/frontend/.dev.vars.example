# Next.js Worker のローカル開発用。`.dev.vars` にコピーして値を入れる。
# 本番は `wrangler secret put <名前>` で設定する（リポジトリにコミットしない）。

# Google OAuth 2.0 クライアント。Google Cloud Console で作る。
# リダイレクトURIには BETTER_AUTH_URL/api/auth/callback/google を登録する
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# セッションの署名鍵。openssl rand -base64 32 等で作る
BETTER_AUTH_SECRET=""

# Better Auth の baseURL。ローカルの next dev は http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# 管理者のメールアドレス（カンマ区切り）
ADMIN_EMAILS=""
